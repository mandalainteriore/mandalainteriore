# Copia questo file in .env.local (sviluppo) e inserisci gli stessi valori
# nelle variabili d'ambiente del servizio di hosting (Vercel o Netlify).

# Chiave API di Brevo: Brevo > SMTP & API > API Keys > "Generate a new API key"
BREVO_API_KEY=

# Mittente delle email del modulo: deve essere un mittente verificato in Brevo
# (Brevo > Senders, Domains & Dedicated IPs). Meglio un indirizzo del dominio del sito.
BREVO_MITTENTE_EMAIL=

# Chi riceve i messaggi del modulo di contatto
CONTATTI_DESTINATARIO=roxana.zlate11@gmail.com

# Indirizzo definitivo del sito
NEXT_PUBLIC_SITE_URL=https://mandalainteriore.it

# Sanity: token con permesso di scrittura, serve solo allo script di importazione
# (npm run importa-sanity). Sanity > API > Tokens. Non serve sull'hosting.
SANITY_API_WRITE_TOKEN=

# Segreto del webhook che aggiorna il sito appena si pubblica su Sanity.
# Una stringa casuale lunga: la stessa va inserita nel webhook su sanity.io/manage > API > Webhooks.
SANITY_REVALIDATE_SECRET=
